# venv / 缓存
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# 本地私密配置（不要提交 token / API key）
.env
.env.*
!.env.example

# 实验输出（结果 JSON 不 commit, 在 wandb 看; 但 checkpoint 一定不 commit）
results/*.jsonl
results/**/*.jsonl
results/archive_*/
results/wandb_export/
results/checkpoints/
results/figures/
.aim/
wandb/

# 远程实验缓存 / 标签文件（只提交轻量 jsonl/summary，不提交 teacher-label npz）
refine-logs/remote-results/**/*.npz
refine-logs/remote-results/**/*.pt
refine-logs/remote-results/**/*.pth
refine-logs/remote-results/**/*.ckpt

# D4RL 缓存（每人本地自动下，不 commit）
.d4rl/

# 数据 / 大文件
data/
*.h5
*.hdf5
*.pkl

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# 笔记本输出
*.ipynb_checkpoints

# 临时
*.log
*.tmp
nohup.out

# LaTeX build artifacts / local sync worktrees
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
paper-overleaf/
paper-sjtu-sync/
paper-sjtu-rl-sync/
